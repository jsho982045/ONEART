# Copy to .env.local and fill in. Never commit .env.local.
#
# Quickest way to try everything: leave the Supabase lines empty (or set NEXT_PUBLIC_ONEART_BACKEND=local)
# and run `npm run dev`. The app runs entirely in your browser; open two tabs to paint together.

# Force local test mode even when Supabase keys are filled in: local | (empty)
NEXT_PUBLIC_ONEART_BACKEND=

# Public URL of the site (emails, share links). http://localhost:3003 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Supabase → Project Settings → API. Use the oneart-DEV project locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key (bot protection on signup).
# Also enable Captcha in Supabase → Authentication → Attack Protection and paste the Turnstile secret there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Worker only (Railway "worker" service). NEVER put these in the web service or in the browser. ----
# Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional lifecycle emails ("3 days left", "finished") via Resend.
RESEND_API_KEY=
EMAIL_FROM=oneart <hello@your-domain.com>
WORKER_INTERVAL_MINUTES=5

# ---- Web service, server side only: buying the finished piece (Stripe) ----
# Stripe → Developers → API keys (use TEST keys on dev). The webhook secret comes from
# `stripe listen --forward-to localhost:3003/api/stripe/webhook` locally, or the dashboard webhook in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The web service also needs SUPABASE_SERVICE_ROLE_KEY (above) for the Stripe webhook and download links.
