# ONEART — local environment template
#
# Copy this file to `.env.local` and fill in the values for the **oneart-dev**
# Supabase project. `.env.local` is gitignored and must never be committed.
#
# Production values are set in the Vercel dashboard (Production scope ->
# oneart-prod, Preview scope -> oneart-dev). Nothing environment-specific is
# hardcoded in application code — every value is read through src/lib/config/env.ts.

# --- Supabase (client-safe, exposed to the browser) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key (safe for the browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only, NEVER exposed to the browser) ---
# Service role key. Bypasses RLS. Only used in server-side code, if at all.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Absolute base URL of this deployment. Local dev: http://localhost:3000
# Used for auth redirect URLs (email confirmation, OAuth callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase CLI (local tooling only, not read by the app) ---
# The oneart-dev project ref (the subdomain in NEXT_PUBLIC_SUPABASE_URL).
# Used by `npx supabase link --project-ref $SUPABASE_PROJECT_REF`.
SUPABASE_PROJECT_REF=
