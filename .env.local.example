# Copy to .env.local and fill in. Use the oneart-DEV Supabase project locally.
# Production values live in Vercel's dashboard (Production environment), never in git.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key (bot protection on signup).
# If you set this, also enable Captcha protection in Supabase → Authentication → Attack Protection
# and paste the Turnstile *secret* key there. Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
