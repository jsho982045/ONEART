{
  "name": "oneart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/db-test.mjs",
    "dev:local": "NEXT_PUBLIC_ONEART_BACKEND=local next dev -p 3003",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:db",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/la-belle-aurore": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@napi-rs/canvas": "^0.1.65",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "14.2.35",
    "perfect-freehand": "^1.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "stripe": "^17.4.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
